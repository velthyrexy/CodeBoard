<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/codeboard_black"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CodeBoard"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/codeboard_yellow"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart keyboard built for programming."
        android:textColor="@color/codeboard_white"
        android:textAlignment="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnEnableKeyboard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Enable Keyboard"
        android:textColor="@color/codeboard_black"
        android:backgroundTint="@color/codeboard_yellow"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSelectLanguage"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Select Language (Luau)"
        android:textColor="@color/codeboard_white"
        android:backgroundTint="@color/codeboard_dark_gray"
        android:layout_marginBottom="16dp"/>
</LinearLayout>
